NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=biblioteca_db
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

JWT_SECRET=
JWT_EXPIRES_IN=8h

# Solo usadas por `npm run seed:db` para crear el primer usuario ADMIN.
# No se guardan en la base de datos: solo sirven para ese script.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRES=
ADMIN_APELLIDOS=

# Cloudinary (para subir imágenes: portadas de libros, fotos de autores,
# avatares, banners). Crea una cuenta gratuita en https://cloudinary.com y
# copia estos tres valores desde su dashboard. Si se dejan vacías, la subida
# de imágenes responde con error 503 pero el resto de la app sigue funcionando.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# URL del frontend, usada para armar el enlace de recuperación de contraseña
FRONTEND_URL=http://localhost:5173

# Configuración SMTP para el envío de correos (recuperación de contraseña, etc.)
# Si se dejan vacías, el correo no se envía y solo se registra en consola (útil en desarrollo)

# Servidor SMTP de tu proveedor de correo. Lo da el proveedor, por ejemplo:
#   Gmail: smtp.gmail.com | Outlook/Office365: smtp.office365.com
#   Servicios transaccionales (recomendados para producción): Brevo (Sendinblue),
#   Mailgun, Resend, Amazon SES, etc. — el host aparece en su panel de "SMTP settings".
SMTP_HOST=

# Puerto del servidor SMTP: 587 para TLS (lo normal) o 465 para SSL.
SMTP_PORT=587

# true si usas el puerto 465 (SSL), false si usas 587 (TLS).
SMTP_SECURE=false

# Usuario SMTP. En Gmail/Outlook es tu correo completo; en servicios
# transaccionales suele ser un usuario o API key que te asigna su panel.
SMTP_USER=

# Contraseña SMTP. NO uses tu contraseña normal de la cuenta:
#   Gmail: genera una "contraseña de aplicación" en
#     https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos activada).
#   Servicios transaccionales: usa la API key/SMTP key de su panel.
SMTP_PASS=

# Dirección que verá el destinatario como remitente. Debe ser un correo/dominio
# verificado en tu proveedor SMTP (en Gmail/Outlook, usa el mismo que SMTP_USER).
MAIL_FROM=