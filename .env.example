NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=biblioteca_db
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

JWT_SECRET=
JWT_EXPIRES_IN=8h

# Solo usadas por `npm run seed:db` para crear el primer usuario ADMIN.
# No se guardan en la base de datos: solo sirven para ese script.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRES=
ADMIN_APELLIDOS=

# Cloudinary (para subir imágenes: portadas de libros, fotos de autores,
# avatares, banners). Crea una cuenta gratuita en https://cloudinary.com y
# copia estos tres valores desde su dashboard. Si se dejan vacías, la subida
# de imágenes responde con error 503 pero el resto de la app sigue funcionando.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# URL del frontend, usada para armar el enlace de recuperación de contraseña
FRONTEND_URL=http://localhost:5173

# Envío de correos (recuperación de contraseña, etc.) vía la API HTTP de Brevo.
# Se usa la API en vez de SMTP porque muchos hostings gratuitos (Railway
# incluido) bloquean los puertos SMTP salientes. Si se dejan vacías, el correo
# no se envía y solo se registra en consola (útil en desarrollo).

# API key de Brevo: panel de Brevo → SMTP & API → pestaña API Keys.
BREVO_API_KEY=

# Dirección que verá el destinatario como remitente. Debe estar verificada en
# Brevo (panel → Senders, Domains & Dedicated IPs → Senders).
MAIL_FROM=